# Secret Key Flask
SECRET_KEY=secret-key-super-rahasia-ganti-di-production

# Kredensial Login Akses Dashboard adm.mbelik.com
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
REQUIRE_LOGIN=True

# Configuration Database
DATABASE_URL=sqlite:///ad_metrics.sqlite

# Google OAuth 2.0 Credentials (domain: adm.mbelik.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://adm.mbelik.com/auth/callback
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Google Ad Manager (GAM) Credentials
GAM_NETWORK_CODE=123456789
GAM_APPLICATION_NAME=AdManagerDashboard

# Google Ads Credentials (MCC ID & Client ID)
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890 # MCC ID / Manager Account ID
GOOGLE_ADS_CUSTOMER_ID=987-654-3210       # Client Account ID

# Force Mock Data Mode (True/False)
USE_MOCK_DATA=True
